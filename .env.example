# Copy to .env and fill in. Never commit .env.
SECURERAG_SECRET=change-me-to-a-long-random-string
SECURERAG_ANSWERER=extractive        # or claude (needs: uv sync --extra claude)
ANTHROPIC_API_KEY=your-key-here      # only for SECURERAG_ANSWERER=claude
SECURERAG_AUDIT_DB=audit.db          # default is in memory
SECURERAG_DEMO_TOKENS=1              # 0 disables /api/users (the demo token handout)
